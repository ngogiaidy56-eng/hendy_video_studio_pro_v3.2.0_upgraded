{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hendy-video-studio-pro-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "vars": {
    "APP_VERSION": "3.2.0",
    "API_BASE_PATH": "/api/v1",
    "CLOUDFLARE_TTS_MODEL": "@cf/myshell-ai/melotts"
  },
  "ai": {
    "binding": "AI"
  },
  "dev": {
    "port": 8788
  }
}
